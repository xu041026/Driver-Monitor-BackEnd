# Local development defaults. Copy to .env only when changing settings.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# For production, set DEBUG=0, use a private random secret and an HTTPS proxy.
# DJANGO_SECRET_KEY=replace-with-a-new-private-random-secret
# DJANGO_HTTPS=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DMS_DATA_DIR=/var/lib/driver-monitor-backend
